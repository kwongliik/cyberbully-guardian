    {
        "id": "9c0ed69c403c8ee5",
        "type": "function",
        "z": "ca9d9739e268a84d",
        "name": "Notification",
        "func": "let last = context.get(\"last\") || 0;\nlet now = Date.now();\n\nif (msg.payload.alert === true && (now - last > 5000)) {\n    context.set(\"last\", now);\n\n    let label = msg.payload.label || \"unknown\";\n    let confidence = Math.round((msg.payload.confidence || 0) * 100);\n\n    // ✅ Severity based on percentage\n    let severity = confidence > 85 ? \"HIGH\" :\n        confidence > 70 ? \"MEDIUM\" : \"LOW\";\n    \n    let severityIcon = severity === \"HIGH\" ? \"🔴\" :\n        severity === \"MEDIUM\" ? \"🟡\" : \"🟢\";\n\n    msg.payload = `⚠️ Cyberbullying detected!\nType: ${label}\nConfidence: ${confidence}%\nSeverity: ${severityIcon} ${severity}`;\n\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 620,
