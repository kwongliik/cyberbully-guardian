    {
        "id": "4",
        "type": "function",
        "z": "ca9d9739e268a84d",
        "name": "Decision Engine",
        "func": "if (!msg.payload) return null;\n\nlet confidence = msg.payload.confidence || 0;\nlet alert = msg.payload.alert;\nlet label = msg.payload.label || \"unknown\";\n\nlet confidencePct = Math.round(confidence * 100);\nlet severity = confidence > 0.85 ? \"HIGH\" :\n    confidence > 0.7 ? \"MEDIUM\" : \"LOW\";\n\n// Output 1 → text\nlet textMsg = {};\ntextMsg.payload = alert\n    ? `⚠️ Cyberbullying (${label}) - ${severity} (${confidencePct}%)`\n    : \"✅ Normal\";\n\n// Output 2 → gauge\nlet gaugeMsg = {};\ngaugeMsg.payload = confidencePct;\n\n// Output 3 → chart\nlet chartMsg = {};\nchartMsg.topic = \"Confidence\";\nchartMsg.payload = confidencePct;\n\n// Output 4 → alerts\nlet alertMsg = {};\nalertMsg.payload = msg.payload;\n\n// Output 5 → HTTP response\n//msg.payload = msg.payload;\n\nreturn [textMsg, gaugeMsg, chartMsg, alertMsg, msg];",
        "outputs": 5,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
